# GymPilot_frontend environment -- copy to .env and fill in.
#
# Everything here starts with NEXT_PUBLIC_, which means Next.js bakes it into
# the JavaScript sent to browsers at BUILD time. Never put a secret in one, and
# rebuild after changing any of them.

# The GymPilot API (GymPilot_backend), without a trailing slash. Every gym's
# site talks to this one API; the API picks the gym from the site's domain.
# Its host is also allowed for images, since uploads can be served from
# /uploads on the API.
NEXT_PUBLIC_BACKEND_URL=http://localhost:4000

# The platform panel (GymPilot_frontendAdmin). Old /super-admin links on a
# gym's site redirect here.
NEXT_PUBLIC_PLATFORM_ADMIN_URL=http://localhost:3001

# This site's public address. Only a fallback: each gym's own Site URL from
# Admin -> Settings is used for canonical links, the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# One-tap demo logins on the sign-in page, for reviewers on a dev or staging
# build ONLY. Leave unset (or anything but "true") in production: when off,
# the demo credentials are not even included in the build.
NEXT_PUBLIC_SHOW_DEMO_LOGINS=false
